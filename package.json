{
    "name": "mcp-node-server",
    "version": "1.0.0",
    "description": "Local MCP-like Node server (discovery, register, token, SSE, invocation + employee CRUD)",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "start:stdio": "node src/stdio-server.js",
        "dev": "nodemon --watch src --exec node src/server.js",
        "dev:stdio": "nodemon --watch src --exec node src/stdio-server.js"
    },
    "dependencies": {
        "body-parser": "^1.20.4",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "express": "^4.22.1",
        "fs-extra": "^11.3.2",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.11"
    },
    "engines": {
        "node": ">=18"
    }
}
